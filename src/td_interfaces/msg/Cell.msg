# Клетка игрового поля.
#
# Каноническое имя вида "A3": буква = строка (A..F, сверху вниз по фото поля),
# цифра = столбец (1..6, слева направо). row/col — те же данные в виде
# нуль-индексированных чисел, чтобы код не занимался парсингом строк.
#
# Пустая клетка (неизвестно / нет данных) кодируется как name == "" и
# row == col == 255.

uint8 UNKNOWN_INDEX = 255

string name
uint8 row
uint8 col
